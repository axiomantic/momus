{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["momus/extensions/**/*.ts"]
}
